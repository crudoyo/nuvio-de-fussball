{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nuvio-de-fussball",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "vars": {
    "SEASON": "2026",
    "DADDY_WEB_PLAYERS": "true",
    "NATIVE_ONLY": "false",
    "NATIVE_VERIFY_MANIFESTS": "true",
    "DADDY_NATIVE_RESOLVE": "true"
  }
}
